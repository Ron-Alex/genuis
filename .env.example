# Copy this file to .env in the genuis folder. Never use NEXT_PUBLIC_ for keys.
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# With no Nessie key the app uses clearly labeled fixtures automatically.
# Set false to require live Nessie, or true to deliberately use fixtures.
# NESSIE_DEMO_MODE=false

# OpenRouter credentials and model for Nemotron.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# No OpenRouter key: explicitly labeled, deterministic demo planner.
# With a key configured, model errors never silently fall back to demo logic.
